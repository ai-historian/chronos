{
  "name": "chronos-v2",
  "productName": "Chronos",
  "version": "0.3.0",
  "description": "Chronos standalone app: AI agent for extracting structured data from scanned primary sources",
  "homepage": "https://github.com/ai-historian/chronos",
  "author": {
    "name": "Lorenz Hufe",
    "email": "lorenz.hufe@posteo.de"
  },
  "private": true,
  "type": "commonjs",
  "main": "out/main.js",
  "piVersion": "0.84.4",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "electron .",
    "dev": "npm run build && electron . --no-sandbox",
    "dist": "npm run bundle-agent && npm run build && electron-builder",
    "bundle-agent": "node scripts/bundle-agent.mjs",
    "canary": "node --import tsx scripts/rpc-canary.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "dompurify": "^3.4.0",
    "dotenv": "^16.0.0",
    "lit": "^3.3.0",
    "marked": "^18.0.0",
    "mupdf": "^1.27.0",
    "pdf-lib": "^1.17.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
